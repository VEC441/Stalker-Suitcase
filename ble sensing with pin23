#include <Arduino.h>
#include <NimBLEDevice.h>

// ====== 可调参数 ======
const int LED_PIN   = 2;     // LED 引脚（原来的蓝灯）
const int SIG_PIN   = 23;    // 新增：信号输出引脚（可改成你想要的脚）
const int RSSI_MIN  = -75;   // 你场景下“较远”的 RSSI
const int RSSI_MAX  = -50;   // 你场景下“较近”的 RSSI
const float GAMMA   = 2.2f;  // 亮度增强（2.0~2.4 常用）
// =====================

class MyServerCallbacks : public NimBLEServerCallbacks {
  void onConnect(NimBLEServer* pServer) {
    Serial.println("✅ 手机已连接");
  }
  void onDisconnect(NimBLEServer* pServer) {
    Serial.println("❌ 手机断开，重新广播...");
    NimBLEDevice::startAdvertising();
  }
};

void setup() {
  Serial.begin(115200);

  // ESP32 Core 3.x：按“引脚”附着 PWM
  // 两个引脚都挂到 5kHz / 8bit 的 PWM 上
  ledcAttach(LED_PIN, 5000, 8);
  ledcAttach(SIG_PIN, 5000, 8);   // 新增：信号引脚的 PWM

  // 初始化 BLE
  NimBLEDevice::init("VictorESP32");
  NimBLEDevice::setPower(ESP_PWR_LVL_P9);

  NimBLEServer* pServer = NimBLEDevice::createServer();
  pServer->setCallbacks(new MyServerCallbacks());

  NimBLEService* service = pServer->createService("1234");
  service->start();

  NimBLEAdvertising* adv = NimBLEDevice::getAdvertising();
  adv->addServiceUUID(service->getUUID());
  NimBLEDevice::startAdvertising();

  Serial.println("📡 VictorESP32 正在广播，可用手机连接...");
}

void loop() {
  NimBLEServer* srv = NimBLEDevice::getServer();
  int bestRSSI = -1000;

  if (srv && srv->getConnectedCount() > 0) {
    std::vector<uint16_t> peers = srv->getPeerDevices();
    for (uint16_t handle : peers) {
      NimBLEClient* cli = srv->getClient(handle);
      if (cli) {
        int rssi = cli->getRssi();               // dBm：-45 > -70 表示更强
        if (rssi > bestRSSI) bestRSSI = rssi;
      }
    }
    if (bestRSSI > -1000) {
      Serial.print("📶 RSSI = ");
      Serial.println(bestRSSI);
    }
  }

  // 未连接或无RSSI → 熄灭（LED & 信号同时为 0）
  if (bestRSSI == -1000) {
    ledcWrite(LED_PIN, 0);
    ledcWrite(SIG_PIN, 0);
    delay(300);
    return;
  }

  // 1) 限幅
  int rssiClamped = constrain(bestRSSI, RSSI_MIN, RSSI_MAX);

  // 2) 线性映射到 0~255
  int lin = map(rssiClamped, RSSI_MIN, RSSI_MAX, 0, 255);
  lin = constrain(lin, 0, 255);

  // 3) 伽玛校正
  float norm = lin / 255.0f;
  int brightness = (int)(powf(norm, GAMMA) * 255.0f + 0.5f);

  // 如果 LED/SIG 是“低电平点亮”，反向占空比：
  // brightness = 255 - brightness;

  // —— 同步输出到两个引脚 ——
  ledcWrite(LED_PIN, brightness);  // 原 LED
  ledcWrite(SIG_PIN, brightness);  // 新增：信号引脚，强度与 LED 一致

  Serial.print("💡 亮度/信号占空比 = ");
  Serial.println(brightness);

  delay(300);
}
